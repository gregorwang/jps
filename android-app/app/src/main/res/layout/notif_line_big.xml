<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded 朝の一句: the manga panel (bitmap) and, for the morning line, 原声 / 挟む. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/notif_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitStart" />

    <LinearLayout
        android:id="@+id/notif_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/notif_play"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/notif_button"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/notif_play_bars"
                android:layout_width="12dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="原声"
                android:textColor="@color/notif_ink"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_save"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/notif_button"
            android:gravity="center"
            android:textColor="@color/notif_ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
