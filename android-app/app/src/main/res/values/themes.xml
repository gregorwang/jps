<resources>
    <style name="Theme.AnimeJapaneseLab" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#FBF9F6</item>
        <item name="android:statusBarColor">#FBF9F6</item>
        <item name="android:navigationBarColor">#FBF9F6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.AnimeJapaneseLab.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FBF9F6</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AnimeJapaneseLab</item>
    </style>
</resources>
